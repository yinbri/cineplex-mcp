{
  "name": "cineplex-mcp",
  "version": "1.0.0",
  "description": "MCP server for finding Cineplex Canada showtimes with good seats available (personal-use, unofficial API scraping).",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "bin": {
    "cineplex-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/",
    "smoke": "node scripts/smoke.mjs",
    "preview": "node scripts/preview-seatmap.mjs",
    "preview:watch": "node scripts/preview-seatmap.mjs --watch",
    "preview:cdn": "node scripts/build-shell.mjs && node scripts/preview-seatmap.mjs --cdn",
    "build:shell": "node scripts/build-shell.mjs",
    "build:locations": "node scripts/build-location-data.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  }
}
